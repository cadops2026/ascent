# ASCENT — frontend environment (Vite). Copy to .env.local and fill in.
# These two are PUBLIC (safe in the browser): the anon key is gated by Row-Level Security.
# Third-party data-API keys (Finnhub / CoinGecko / FMP / FRED) NEVER live here —
# they live in Supabase secrets and are only ever read by Edge Functions. (Invariant #10.)

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY
